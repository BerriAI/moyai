{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "application": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["singlePod", "externalFleets"]},
        "fleetIngress": {"type": "string"}
      },
      "required": ["mode", "fleetIngress"],
      "additionalProperties": false
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9_-]+)*/?$"
    },
    "installationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,7}$"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "runtimeSecret": {
      "type": "string",
      "minLength": 1
    },
    "databaseSecret": {
      "type": "string",
      "minLength": 1
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "maxConnections": {
          "type": "integer",
          "minimum": 20,
          "maximum": 2000
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "temporal": {
      "type": "object",
      "properties": {
        "bundled": {
          "type": "boolean"
        },
        "tls": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "brokerUrl": {
      "type": "string",
      "pattern": "^$|^https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9_-]+)*/?$"
    },
    "kubernetesWorkspaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "warmPool": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
        },
        "template": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
        },
        "routerNamespace": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "routerUrl": {
          "type": "string",
          "pattern": "^$|^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/?$"
        },
        "routerAudience": {
          "type": "string",
          "minLength": 1
        },
        "routerPodLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "image",
    "publicUrl",
    "installationId",
    "runtimeSecret",
    "databaseSecret"
  ]
}
