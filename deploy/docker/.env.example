# Use the immutable image reference from the release's image.txt.
MOYAI_IMAGE=
COMPOSE_PROJECT_NAME=moyai
# Choose compose.yaml or compose.split.yaml. Add :compose.temporal.yaml for bundled Temporal.
COMPOSE_FILE=compose.yaml
MOYAI_INSTALLATION_ID=moyai
MOYAI_BIND_ADDRESS=127.0.0.1
MOYAI_PORT=8787

# Terminate HTTPS at your existing ingress and preserve the original Host header.
MOYAI_PUBLIC_URL=https://moyai.example.com
# Optional service token if Cloudflare Access protects the public broker routes.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
MOYAI_DATABASE_URL=postgresql://moyai:password@postgres.example.com:5432/moyai
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PREFIX=
MOYAI_NATIVE_OBJECT_PREFIX=
# Leave blank to use the AWS workload credential chain.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=

MOYAI_TEMPORAL_MODE=external
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TLS=true
TEMPORAL_API_KEY=
# Required only for compose.temporal.yaml. Use a dedicated Temporal database password.
MOYAI_TEMPORAL_DATABASE_PASSWORD=

LITELLM_API_BASE=https://your-gateway.example.com/v1
LITELLM_API_KEY=
AGENT_MODEL=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=moyai

# Set an initial password, or retrieve the generated one using the password command.
# Missing keys are generated once and retained in the moyai-state volume.
WORKSPACE_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=
MOYAI_NATIVE_ENCRYPTION_KEY=
