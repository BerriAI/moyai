# Use the immutable image reference from the release's image.txt.
MOYAI_IMAGE=
COMPOSE_PROJECT_NAME=moyai
# Choose compose.yaml or compose.split.yaml. Add :compose.temporal.yaml for bundled Temporal.
COMPOSE_FILE=compose.yaml
MOYAI_INSTALLATION_ID=moyai
MOYAI_BIND_ADDRESS=127.0.0.1
MOYAI_PORT=8787

# Terminate HTTPS at your existing ingress and preserve the original Host header.
# For a path URL, set MOYAI_BASE_PATH to the same path (configure derives it).
MOYAI_BASE_PATH=
MOYAI_PUBLIC_URL=https://moyai.example.com
# Optional service token if Cloudflare Access protects the public broker routes.
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
MOYAI_DATABASE_URL=postgresql://moyai:password@postgres.example.com:5432/moyai
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PREFIX=
MOYAI_NATIVE_OBJECT_PREFIX=
# Leave blank to use the AWS workload credential chain.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=

MOYAI_TEMPORAL_MODE=external
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TLS=true
TEMPORAL_API_KEY=
# Required only for compose.temporal.yaml. Use a dedicated Temporal database password.
MOYAI_TEMPORAL_DATABASE_PASSWORD=

LITELLM_API_BASE=https://your-gateway.example.com/v1
LITELLM_API_KEY=
AGENT_MODEL=
# Select modal or lambda. Lambda uses the host/pod AWS role, not Modal tokens.
SANDBOX_PROVIDER=modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=moyai
MOYAI_MODAL_RUNTIME=vm

# Required when SANDBOX_PROVIDER=lambda. Build and pin the guest image first.
LAMBDA_REGION=us-east-1
LAMBDA_IMAGE=
LAMBDA_IMAGE_VERSION=
LAMBDA_CHECKPOINT_BUCKET=
# Use a different prefix for each installation, including local tests.
LAMBDA_CHECKPOINT_PREFIX=moyai/lambda
SNAPSHOT_TIMEOUT_SECONDS=900
LAMBDA_EXECUTION_ROLE_ARN=
LAMBDA_EGRESS_CONNECTOR=

# Split topology: configure a Slack app, then connect it through Connections.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_ENABLED=false
# Comma-separated Slack user IDs; empty disables inbound sessions.
SLACK_SESSION_USERS=
SLACK_THREAD_CHAT_ENABLED=true
SLACK_DM_ENABLED=true
SLACK_IDENTITY_LINKING_ENABLED=true

# Set an initial password, or retrieve the generated one using the password command.
# Missing keys are generated once and retained in the moyai-state volume.
WORKSPACE_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=
MOYAI_NATIVE_ENCRYPTION_KEY=

# Optional separate machine endpoint; keep the same base path as MOYAI_PUBLIC_URL.
# Empty preserves the existing public URL for broker traffic.
MOYAI_BROKER_URL=
