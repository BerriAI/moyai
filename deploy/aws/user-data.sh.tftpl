#!/bin/bash
set -euo pipefail
umask 077
dnf install -y docker python3 awscli-2
systemctl enable --now amazon-ssm-agent
# Only initialize the exact, independently retained volume created by this stack.
serial='${replace(volume_id, "-", "")}'
device=''
for attempt in $(seq 1 180); do
  device=$(lsblk -ndo PATH,SERIAL | awk -v serial="$serial" '$2 == serial {print $1}')
  [ -n "$device" ] && break
  sleep 2
done
[ -n "$device" ] || { echo 'State volume was not attached'; exit 1; }
if ! blkid "$device" >/dev/null; then mkfs.ext4 -L moyai-state "$device"; fi
uuid=$(blkid -s UUID -o value "$device")
install -d -m 700 /srv/moyai
grep -q "UUID=$uuid " /etc/fstab || echo "UUID=$uuid /srv/moyai ext4 defaults,nofail 0 2" >> /etc/fstab
mount /srv/moyai
install -d -m 700 /srv/moyai/docker /srv/moyai/app /opt/moyai-aws
install -d /etc/docker /etc/systemd/system/docker.service.d /usr/local/lib/docker/cli-plugins
cat >/etc/docker/daemon.json <<'JSON'
{"data-root":"/srv/moyai/docker","log-driver":"awslogs","log-opts":{"awslogs-region":"${region}","awslogs-group":"${log_group}","tag":"{{.Name}}/{{.ID}}"}}
JSON
cat >/etc/systemd/system/docker.service.d/moyai.conf <<'UNIT'
[Unit]
RequiresMountsFor=/srv/moyai
UNIT
cd /opt/moyai-aws
curl --fail --silent --show-error --location https://github.com/docker/compose/releases/download/v5.1.4/docker-compose-linux-x86_64 -o docker-compose-linux-x86_64
curl --fail --silent --show-error --location https://github.com/docker/compose/releases/download/v5.1.4/docker-compose-linux-x86_64.sha256 -o compose.sha256
sha256sum -c compose.sha256
install -m 755 docker-compose-linux-x86_64 /usr/local/lib/docker/cli-plugins/docker-compose
systemctl daemon-reload
systemctl enable --now docker
touch /opt/moyai-aws/host-ready
