# =============================================================================
# Moyai configuration
# =============================================================================
# Copy this file to .env. Local preview runs with every value below left as is:
#   cp .env.example .env
#
# Sections are ordered by what you need first. Each setting shows its default
# (or empty when off); "e.g." comments show an example value. A complete
# production example is at the bottom of this file.
#
# Never commit .env. In the cloud, put secrets in the host's private environment
# (Render dashboard, Modal Secret), not in render.yaml.


# -----------------------------------------------------------------------------
# 1. Core: required to run anywhere
# -----------------------------------------------------------------------------
# Public origin of this workspace. Use the HTTPS URL when hosted.
# e.g. PUBLIC_URL=https://moyai.example.com
PUBLIC_URL=http://127.0.0.1:8787
# SQLite database, saved files, and attachments. Use a persistent disk in the cloud.
# e.g. DATA_DIR=/var/data/moyai
DATA_DIR=.data
# Shown in the UI.
ORGANIZATION_NAME=Internal team

# Persist both in a secret store and never rotate ENCRYPTION_KEY: saved app
# connections cannot be decrypted without it. Optional locally.
#   SESSION_SECRET: python -c 'import secrets; print(secrets.token_urlsafe(48))'
#   ENCRYPTION_KEY: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SESSION_SECRET=
ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# 2. Sign-in: required before exposing on a cloud host or HTTPS tunnel
# -----------------------------------------------------------------------------
# Google Workspace SSO. Create a Web application OAuth client with callback
# PUBLIC_URL/auth/google/callback. Only openid/email/profile are requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Workspace domains allowed to sign in. e.g. example.com,example.org
GOOGLE_ALLOWED_DOMAINS=
# Comma-separated administrator emails; other allowed users become members.
# e.g. GOOGLE_ADMIN_EMAILS=admin@example.com
GOOGLE_ADMIN_EMAILS=

# Password login. Keep enabled during setup; set false after verifying a real
# Google admin login (false also invalidates existing password sessions).
PASSWORD_LOGIN_ENABLED=true
# Administrator password, at least 16 characters. Manages apps and approves writes.
WORKSPACE_PASSWORD=
# Optional member password, distinct and at least 16 characters. Members run
# sessions and read shared results but cannot change connections or approve writes.
WORKSPACE_MEMBER_PASSWORD=


# -----------------------------------------------------------------------------
# 3. Models and sandboxes: required for real (non-demo) sessions
# -----------------------------------------------------------------------------
# All inference goes through a LiteLLM gateway.
# e.g. LITELLM_API_BASE=https://litellm.example.com/v1
LITELLM_API_BASE=
LITELLM_API_KEY=
# Model context limits are discovered from the same gateway's /model/info.
# Override custom aliases with verified deployment limits (JSON; example only):
# MODEL_CONTEXT_LIMITS={"your-model-alias":{"context_window":128000,"max_input_tokens":128000,"max_output_tokens":16000}}
# Optional default_output_tokens must match the gateway's effective default.
# Missing limits pause inference. /utils/token_counter is used when available;
# text has a conservative fallback, but images require a working counter.
# Default harness: claude-agent-sdk, hermes, codex, opencode, deepagents, tool-loop.
AGENT_HARNESS=claude-agent-sdk
# Default model only; picker models live in MODEL_CATALOG in app/config.py.
# Empty uses the first catalog model. e.g. AGENT_MODEL=anthropic/claude-opus-5-5
AGENT_MODEL=
# Pinned Hermes Agent commit installed in sandboxes.
HERMES_REVISION=7968c72a3cb80beaae51948378944dd6e3423b96

# Modal runs each agent session in an isolated sandbox.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=hermes-workspace
# Opt into Modal's VM sandbox beta for workloads that need a full kernel.
MODAL_VM_RUNTIME=false

# Voice input: an OpenAI-compatible transcription model on the same gateway.
AUDIO_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional spelling hints. e.g. AUDIO_TRANSCRIPTION_PROMPT=Moyai, LiteLLM, Modal, Temporal
AUDIO_TRANSCRIPTION_PROMPT=


# -----------------------------------------------------------------------------
# 4. Durability: Temporal (strongly recommended in production)
# -----------------------------------------------------------------------------
# Survives restarts and deploys mid-session: sessions resume where they left
# off instead of being interrupted. Run a single app instance on the same disk.
# Enable only after creating the namespace and letting in-flight runs finish.
TEMPORAL_ENABLED=false
# e.g. TEMPORAL_ADDRESS=your-namespace.a1b2c.tmprl.cloud:7233
TEMPORAL_ADDRESS=localhost:7233
# e.g. TEMPORAL_NAMESPACE=your-namespace.a1b2c
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
# True for Temporal Cloud; false only for a local development server.
TEMPORAL_TLS=true
TEMPORAL_TASK_QUEUE=moyai-sessions-v1
TEMPORAL_CHECKPOINT_SECONDS=600
# Startup retry window after a restart; does not limit how long an agent works.
STARTUP_RECOVERY_SECONDS=600


# -----------------------------------------------------------------------------
# 5. Observability: tracing destinations (all optional, can run together)
# -----------------------------------------------------------------------------
# Every destination receives the same agent spans. Each turns on only when its
# credentials are set. Keys stay on the server, never in sandboxes.

# Label attached to every trace. e.g. production, staging, verification
TRACE_ENVIRONMENT=development

# LiteLLM Lens (recommended). Uses its own key, separate from inference.
# Set both to enable. e.g. LITELLM_TRACE_ENDPOINT=https://litellm.example.com/v1/traces
LITELLM_TRACE_ENDPOINT=
LITELLM_TRACE_API_KEY=

# Langfuse. Both project keys are required.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development

# LangSmith.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=moyai
LANGSMITH_WORKSPACE_ID=

# Braintrust. project_id:<id> survives project renames; project_name:<name> also works.
BRAINTRUST_API_URL=https://api.braintrust.dev
BRAINTRUST_API_KEY=
BRAINTRUST_PARENT=project_name:moyai

# Raindrop.
RAINDROP_WRITE_KEY=
RAINDROP_PROJECT_ID=


# -----------------------------------------------------------------------------
# 6. Slack bot: start and continue sessions from Slack
# -----------------------------------------------------------------------------
# Signed HTTP events at PUBLIC_URL/hooks/slack/events (no Socket Mode token).
# Bot scopes: app_mentions:read, chat:write, im:write, files:write,
#   channels:history, groups:history, im:history, reactions:write,
#   assistant:write (plus users:read, users:read.email for identity linking).
# Events: app_mention, message.channels, message.groups, message.im.
# Enable App Home's Messages tab. Reconnect Slack after adding scopes.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_ENABLED=false
# Comma-separated Slack user IDs allowed to start sessions, or * for the whole
# installed workspace. Empty disables inbound sessions. e.g. U01ABCDEF,U02GHIJKL
SLACK_SESSION_USERS=
SLACK_THREAD_CHAT_ENABLED=true
SLACK_DM_ENABLED=true
# Match Slack users to Google sign-ins by verified company email.
SLACK_IDENTITY_LINKING_ENABLED=true


# -----------------------------------------------------------------------------
# 7. App connections: OAuth for "Continue with…" sign-in
# -----------------------------------------------------------------------------
# Optional: tokens can also be pasted on the Connections page instead.
# Callback for each app: PUBLIC_URL/oauth/{linear|notion|slack}/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# 8. GitHub: shared GitHub App for repositories and pull requests
# -----------------------------------------------------------------------------
# Register/install the App from Connections. Its private key is encrypted in the
# database; installation tokens never enter agent sandboxes.
# Select GitHub repositories in Connections; Moyai stores permanent IDs.
# No repository list belongs in the deployment environment.
# Detect connected repositories and prepare their environments on first use.
# Adding repositories never starts a build by itself.
AUTO_PREPARE_REPOSITORIES=true


# -----------------------------------------------------------------------------
# 9. Limits and tuning: defaults suit most deployments
# -----------------------------------------------------------------------------
MAX_CONCURRENT_RUNS=100
MAX_PENDING_RUNS=1000
MAX_PARALLEL_AGENTS=100
MAX_CONCURRENT_MODEL_REQUESTS=8
# 0 removes the response deadline and iteration cap.
RUN_TIMEOUT_SECONDS=0
MAX_AGENT_ITERATIONS=0
# Renew the sandbox machine after 23h between tool rounds, keeping the same chat.
SANDBOX_ROTATION_SECONDS=82800
# Keep an idle chat sandbox warm for 5 minutes (with Temporal); 0 releases immediately.
SANDBOX_IDLE_SECONDS=300
# Time allowed to save a sandbox's filesystem snapshot.
SNAPSHOT_TIMEOUT_SECONDS=180
# Uploaded originals and previews share the database disk.
ATTACHMENT_STORAGE_LIMIT_MB=256
# Automatic session titles from a small model on the gateway.
SESSION_TITLES_ENABLED=true
SESSION_TITLE_MODEL=openai/gpt-4.1-nano


# -----------------------------------------------------------------------------
# 10. Infrastructure cost tracking (Settings → Spend)
# -----------------------------------------------------------------------------
# Modal billing export requires a Team/Enterprise plan. Uses the Modal token
# above and only the MODAL_APP_NAME app; never imports the whole workspace.
MODAL_BILLING_ENABLED=false
# Additional Modal objects used only by Moyai. e.g. vo-AbC123,vo-DeF456
MODAL_BILLING_OBJECT_IDS=
# Separate Temporal Cloud Ops key with billing-report permission. Costs are
# filtered to TEMPORAL_NAMESPACE; the worker key is never reused for this.
TEMPORAL_BILLING_API_KEY=


# =============================================================================
# Example: production deployment
# =============================================================================
# A typical hosted setup with Google SSO, Modal, Temporal Cloud, Lens and the
# Slack bot. All values are placeholders.
#
# PUBLIC_URL=https://moyai.example.com
# DATA_DIR=/var/data/moyai
# ORGANIZATION_NAME=Example Inc
# SESSION_SECRET=<generated>
# ENCRYPTION_KEY=<generated>
#
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=<secret>
# GOOGLE_ALLOWED_DOMAINS=example.com
# GOOGLE_ADMIN_EMAILS=admin@example.com
# PASSWORD_LOGIN_ENABLED=false
#
# LITELLM_API_BASE=https://litellm.example.com/v1
# LITELLM_API_KEY=<key>
# MODAL_TOKEN_ID=<token id>
# MODAL_TOKEN_SECRET=<token secret>
#
# TEMPORAL_ENABLED=true
# TEMPORAL_ADDRESS=moyai.a1b2c.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=moyai.a1b2c
# TEMPORAL_API_KEY=<key>
#
# TRACE_ENVIRONMENT=production
# LITELLM_TRACE_ENDPOINT=https://litellm.example.com/v1/traces
# LITELLM_TRACE_API_KEY=<key>
#
# SLACK_CLIENT_ID=<id>
# SLACK_CLIENT_SECRET=<secret>
# SLACK_SIGNING_SECRET=<secret>
# SLACK_BOT_ENABLED=true
# SLACK_SESSION_USERS=*
#
# Choose repositories in Connections → GitHub → Choose repositories.
