# Local trial: copy to .env at the repository root. Never commit real values.
# Existing deployments: preserve their configuration; see docs/pydantic-deployment.md.
WORKSPACE_PASSWORD=
MOYAI_ADMIN_USER=admin
DATA_DIR=.data
ENCRYPTION_KEY=
LITELLM_API_BASE=https://your-gateway.example/v1
LITELLM_API_KEY=
AGENT_MODEL=openai/gpt-6-astra
MOYAI_MODELS=openai/gpt-6-astra
MOYAI_MODEL_CALL_LIMIT=100
MOYAI_MODEL_TIMEOUT=300

# API and worker processes use the same database, encryption key and object storage.
# MOYAI_DATABASE_URL=postgresql://user:password@localhost/moyai
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=moyai-pydantic-v1
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=true
# MOYAI_ARTIFACT_BUCKET=
# MOYAI_ARTIFACT_ENDPOINT=

# Isolated coding computers. These account keys never enter agent workspaces.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MOYAI_MODAL_APP=moyai-pydantic
# vm (default) uses a full Linux kernel; set gvisor to opt into that runtime.
# Deployment-wide: use the same value in API, worker, and image-build processes.
MOYAI_MODAL_RUNTIME=vm
MOYAI_COMPUTER_TIMEOUT=3600
MOYAI_COMPUTER_IDLE_TIMEOUT=600

# Set both for an HTTPS deployment.
# MOYAI_PUBLIC_URL=https://moyai.example.com
# MOYAI_SECURE_COOKIES=true

# Optional Slack bot surface, separate from personal Slack tool connections.
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_TEAM_ID=
