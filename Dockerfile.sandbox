FROM public.ecr.aws/docker/library/python:3.14-slim@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170 AS transport
RUN apt-get update && apt-get install -y --no-install-recommends git chromium xvfb ffmpeg openbox tint2 xterm xdotool xclip x11-xserver-utils ca-certificates build-essential libffi-dev ripgrep nodejs npm \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir cryptography playwright==1.58.0 pillow==12.3.0
COPY sandbox /opt/workspace-runner/sandbox
COPY agent /opt/workspace-runner/agent
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/opt/workspace-runner:/opt/hermes HERMES_RUNTIME_DIR=/opt/hermes-tools \
    HERMES_PYTHON=/opt/hermes-env/bin/python HERMES_HOME=/tmp/hermes-home GIT_TERMINAL_PROMPT=0
EXPOSE 80
CMD ["python", "/opt/workspace-runner/sandbox/substrate_guest.py"]

FROM transport AS workspace
ARG HERMES_REVISION=7968c72a3cb80beaae51948378944dd6e3423b96
RUN git init /opt/hermes && cd /opt/hermes && git remote add origin https://github.com/NousResearch/hermes-agent.git \
    && git fetch --depth 1 origin "$HERMES_REVISION" && git checkout --detach FETCH_HEAD \
    && python -m pm.build_env --source /opt/hermes --out /opt/hermes-env --no-install-project --extra mcp
RUN /opt/hermes-env/bin/python /opt/workspace-runner/sandbox/harness_dependencies.py \
    && python /opt/workspace-runner/sandbox/install_access_tools.py \
    && python /opt/workspace-runner/sandbox/hermes_compat.py \
    && cd /opt/hermes && /opt/hermes-env/bin/python -c 'from run_agent import AIAgent; import mcp; import claude_agent_sdk'

# Lambda snapshots only this idle HTTP service. No agent/model connection is
# opened during the image build; command and TLS clients start in each new VM.
FROM workspace AS lambda-workspace
COPY sandbox /opt/moyai-lambda
# Discard download/build caches before recording the immutable image. Installed
# packages remain in their environments; caches created by sessions are still
# included in every checkpoint. Cold reads of these archives cost minutes.
RUN rm -rf /root/.cache/pip /root/.npm/_cacache /tmp/hermes-home/cache/uv \
    && python /opt/moyai-lambda/lambda_guest.py baseline
CMD ["python", "/opt/moyai-lambda/lambda_guest.py"]

# Preserve the Substrate image as the default build target.
FROM workspace AS default
