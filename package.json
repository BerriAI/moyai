{
  "name": "moyai-ui",
  "private": true,
  "scripts": {
    "prebuild": "npm run generate",
    "build": "npm run build:assets",
    "build:assets": "vite build",
    "predev": "npm run generate",
    "dev": "vite build --watch",
    "preview": "node scripts/settings_ui_preview.cjs",
    "test": "node --test tests/*.cjs",
    "test:ui": "node --test tests/browser/shadcn_ui.cjs tests/browser/navigation_loading.cjs tests/browser/message_history.cjs",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "generate": "npm run api:generate && npm run routes:generate",
    "routes:generate": "node scripts/generate_routes.mjs",
    "api:client": "openapi-ts",
    "api:generate": ".venv/bin/python scripts/export_frontend_schema.py && npm run api:client"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-react-parser": "^5.2.7",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/router-generator": "^1.167.41",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  }
}
